# ==========================================
# 2. LIMPEZA E EXTRAÇÃO COM REGEX
# ==========================================
# Separa o período de gravação em início e fim (Regex flexível para as/ás/às)
df_analise[['INICIO_GRAVACAO', 'FIM_GRAVACAO']] = df_analise['PERIODO DE GRAVAÇÃO'].str.split(r'\s+[aàá]s\s+', expand=True, regex=True)

# Extrai Vigilante e Saída da coluna AÇÃO TOMADA (Regex flexível para acentuação)
padrao_regex_acao = r"Acompanhado pelo vigilante\s+(.+?)\s+até a sa[íi]da\s+(.+)"
df_analise[['VIGILANTE', 'SAIDA']] = df_analise['AÇÃO TOMADA'].str.extract(padrao_regex_acao, expand=True)

# Remove espaços em branco invisíveis nas pontas das colunas e dos textos
df_analise.columns = df_analise.columns.str.strip()

# ==========================================
# 3. PADRONIZAÇÃO E TRATAMENTO DE FALSOS NULOS
# ==========================================
colunas_texto = ['TURNO', 'LOCAL DE IDENFICAÇÃO', 'TIPO DE OCORRÊNCIA', 'VIGILANTE', 'SAIDA']

for col in colunas_texto:
    # Remove espaços extras e transforma tudo em MAIÚSCULAS
    df_analise[col] = df_analise[col].astype(str).str.strip().str.upper()
    # Corrige o falso nulo 'NAN' textual para o nulo real do Pandas
    df_analise[col] = df_analise[col].replace('NAN', np.nan)
    # Altera para tipo categoria para economizar memória
    df_analise[col] = df_analise[col].astype('category')

# ==========================================
# 4. TRANSFORMAÇÃO DE TIPOS E CÁLCULO DE TEMPO
# ==========================================
# Converte a Data
df_analise['DATA'] = pd.to_datetime(df_analise['DATA'], errors='coerce')

# Converte os Horários (removendo AM/PM automaticamente nos bastidores)
for col in ['HORÁRIO', 'INICIO_GRAVACAO', 'FIM_GRAVACAO']:
    df_analise[col] = pd.to_timedelta(df_analise[col].astype(str), errors='coerce')

# Cria as métricas de duração da gravação
df_analise['DURACAO_GRAVACAO'] = df_analise['FIM_GRAVACAO'] - df_analise['INICIO_GRAVACAO']
df_analise['DURACAO_SEGUNDOS'] = df_analise['DURACAO_GRAVACAO'].dt.total_seconds()

print("--- Tratamento de dados concluído com sucesso! ---")

# ==========================================
# 5. ANÁLISE EXPLORATÓRIA E VISUALIZAÇÃO
# ==========================================
sns.set_theme(style="whitegrid")

# 5.1 Gráfico: Top 10 Saídas
top_10_saidas = df_analise['SAIDA'].value_counts().head(10)
plt.figure(figsize=(10, 6))
sns.barplot(x=top_10_saidas.values, y=top_10_saidas.index, order=top_10_saidas.index, palette="Blues_r")
plt.title("Top 10 Saídas Mais Utilizadas em Acompanhamentos", fontsize=14, fontweight='bold')
plt.xlabel("Quantidade de Acionamentos")
