import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

# ==========================================
# 1. INSPEÇÃO, CONFIGURAÇÃO E CARREGAMENTO
# ==========================================
# Configura o Pandas para mostrar o texto completo das colunas
